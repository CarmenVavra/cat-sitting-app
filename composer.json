{
    "name": "katzenbetreuung/api",
    "description": "JSON API for the Katzenbetreuung app (cat sitting visits & billing)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "App\\": "api/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "api/tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8400 -t api/public api/public/index.php",
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    }
}
