<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory="api/var/.phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="unit">
            <directory>api/tests/Unit</directory>
        </testsuite>
        <testsuite name="functional">
            <directory>api/tests/Functional</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>api/src</directory>
        </include>
    </source>
</phpunit>
